# Claude Code session files (local only)
.claude/

# Build artifacts
build/
.pio/
*.o
*.bin
*.elf

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# Streamlit login credentials (จริง) — commit แค่ secrets.toml.example เป็นเทมเพลตพอ
.streamlit/secrets.toml

# mms_master-main: มี credential จริง (DB password, internal IP, InfluxDB password) — repo นี้ public ห้าม commit
# ตรง ๆ — commit แค่ telegraf.conf.example (เทมเพลต password ถูก redact) แทน .env ไม่มีเทมเพลตเพราะเครื่องอื่น
# มีของตัวเองอยู่แล้ว
mms_master-main/**/.env
mms_master-main/telegraf.conf

# หมายเหตุ: config.db (SQLite) ตั้งใจ commit ไว้ในนี้เลย ไม่ ignore แล้ว — ใช้เป็นตัวข้อมูลตั้งต้น/ตัวเทส
# ร่วมกับ ESP32 จริง (ต้องระวังเรื่อง merge conflict แบบ binary ถ้ามีคนแก้พร้อมกันหลายจุด/หลายเครื่อง)
