# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml (ไฟล์นั้นถูก .gitignore ไว้ ไม่ขึ้น git — เก็บรหัสจริงได้ปลอดภัย)
#
# วิธีสร้าง password_hash: รันคำสั่งนี้แล้วเอาผลลัพธ์มาใส่ (เปลี่ยน "yourpassword" เป็นรหัสที่ต้องการ)
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"

[auth]
username = "admin"
password_hash = "$2b$12$REPLACE_WITH_OUTPUT_OF_THE_COMMAND_ABOVE"
